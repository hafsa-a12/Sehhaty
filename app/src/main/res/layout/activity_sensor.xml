<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gris_fond">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/vert_principal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Capteurs de santé"
                android:textColor="@color/blanc"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Section Podomètre -->
        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Podomètre"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/vert_principal" />

                <!-- Nombre de pas (grand) -->
                <TextView
                    android:id="@+id/tvPas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="52sp"
                    android:textStyle="bold"
                    android:textColor="#1a1a1a"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="pas aujourd'hui"
                    android:textSize="13sp"
                    android:textColor="@color/gris_texte"
                    android:layout_gravity="center" />

                <!-- Barre de progression -->
                <ProgressBar
                    android:id="@+id/progressPas"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_marginTop="12dp"
                    android:progressTint="@color/vert_principal"
                    android:progressBackgroundTint="@color/gris_bordure"
                    android:max="8000"
                    android:progress="0" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/tvStatutPas"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="12sp"
                        android:textColor="@color/gris_texte"
                        android:text="0% de l'objectif" />

                    <TextView
                        android:id="@+id/tvObjectif"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/vert_principal"
                        android:text="Objectif : 8 000 pas" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Section Accéléromètre -->
        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Accéléromètre"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/vert_principal" />

                <TextView
                    android:id="@+id/tvAccelX"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="X : -- m/s²"
                    android:textSize="14sp"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvAccelY"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Y : -- m/s²"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvAccelZ"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Z : -- m/s²"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Section Lumière -->
        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Capteur de lumière"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/vert_principal" />

                <TextView
                    android:id="@+id/tvLumiere"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- lux"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#1a1a1a"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>