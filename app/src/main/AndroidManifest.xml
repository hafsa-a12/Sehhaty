<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Réseau (API REST, Google Maps) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Localisation (médecins proches, carte) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Podomètre (TYPE_STEP_COUNTER) : permission runtime sur Android 10+ -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />

    <application
        android:name=".SehhatyApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SanteApp"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Clé injectée par Gradle depuis local.properties / variable d'environnement MAPS_API_KEY -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- Écran de lancement : connexion (redirige vers MainActivity si déjà connecté) -->
        <activity
            android:name=".activity.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".activity.MainActivity" android:exported="false" />

        <activity android:name=".activity.DoctorListActivity" android:label="Médecins" android:exported="false" />
        <activity android:name=".activity.MapActivity" android:label="Carte" android:exported="false" />
        <activity android:name=".activity.NotesActivity" android:label="Mes Notes" android:exported="false" />
        <activity android:name=".activity.SensorActivity" android:label="Capteurs" android:exported="false" />
        <activity android:name=".activity.ConseilsActivity" android:label="Conseils Santé" android:exported="false" />
    </application>
</manifest>
